{
  "name": "majorops-worker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev":                "wrangler dev",
    "deploy":             "wrangler deploy",
    "deploy:staging":     "wrangler deploy --env staging",
    "deploy:production":  "wrangler deploy --env production",
    "typecheck":          "tsc --noEmit",
    "db:migrate:local":   "wrangler d1 execute majorops-production --local --file=./schema/migrations/001_init.sql",
    "db:migrate:remote":  "wrangler d1 execute majorops-production --remote --file=./schema/migrations/001_init.sql",
    "db:seed:local":      "wrangler d1 execute majorops-production --local --file=./schema/seed.sql",
    "db:query":           "wrangler d1 execute majorops-production --local --command"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.5.3",
    "wrangler": "^3.80.0"
  }
}
